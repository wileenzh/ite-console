{
  "appId": "io.github.wileenzh.ite",
  "appName": "ITE",
  "webDir": "www",
  "backgroundColor": "#0E171C",
  "android": { "allowMixedContent": false },
  "ios": { "contentInset": "never", "scheme": "ITE" },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 1500, "launchAutoHide": false, "backgroundColor": "#0E171C", "showSpinner": false },
    "LocalNotifications": { "smallIcon": "ic_stat_ite", "iconColor": "#1F9D8F" },
    "PushNotifications": { "presentationOptions": ["badge", "sound", "alert"] }
  }
}
