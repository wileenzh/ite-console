{
  "name": "ite-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "ITE store app (iOS and Android): the console with a home screen and tabs for each role, built with Capacitor",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "sync": "node scripts/build-web.mjs && cap sync",
    "android": "node scripts/build-web.mjs && cap sync android && cap open android",
    "ios": "node scripts/build-web.mjs && cap sync ios && cap open ios",
    "icons": "node scripts/make-art.cjs && capacitor-assets generate --android --ios --iconBackgroundColor '#0E171C' --iconBackgroundColorDark '#0E171C' --splashBackgroundColor '#0E171C' --splashBackgroundColorDark '#0E171C'"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3"
  }
}
